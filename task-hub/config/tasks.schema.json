{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taskhub.local/tasks.schema.json",
  "title": "Task Hub workflow configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/task"
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "type"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "select",
            "multi_select",
            "text",
            "textarea",
            "email",
            "datetime"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "placeholder": {
          "type": "string",
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "allow_other": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 20000
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["select", "multi_select"]
              }
            }
          },
          "then": {
            "required": ["options"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multi_select"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "default": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "category",
        "icon",
        "steps",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "icon": {
          "enum": [
            "mail",
            "calendar",
            "document",
            "sheet",
            "slides",
            "terminal",
            "bell"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "format", "fields"],
              "properties": {
                "type": {
                  "const": "export"
                },
                "format": {
                  "enum": [
                    "eml",
                    "ics",
                    "docx",
                    "xlsx",
                    "pptx",
                    "html",
                    "csv",
                    "txt"
                  ]
                },
                "fields": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 20,
                  "propertyNames": {
                    "enum": [
                      "title",
                      "body",
                      "recipient",
                      "start",
                      "end",
                      "location",
                      "minutes"
                    ]
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 20000
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "fields"],
              "properties": {
                "type": {
                  "const": "smtp"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "recipient", "body"],
                  "properties": {
                    "title": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "recipient": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 20000
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "script_id"],
              "properties": {
                "type": {
                  "const": "script"
                },
                "script_id": {
                  "enum": ["system-info"]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "recipe", "fields"],
              "properties": {
                "type": {
                  "const": "foreground"
                },
                "recipe": {
                  "enum": ["web_email"]
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "body"],
                  "properties": {
                    "title": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "body": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "recipient": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "provider": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "delivery": {
                      "type": "string",
                      "maxLength": 20000
                    },
                    "browser": {
                      "type": "string",
                      "maxLength": 20000
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
