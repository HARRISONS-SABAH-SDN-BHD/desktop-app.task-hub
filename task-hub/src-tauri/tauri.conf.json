{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Hub",
  "version": "0.7.7",
  "identifier": "com.taskhub.desktop",
  "build": {
    "beforeDevCommand": "npm run runtime:ensure && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Task Hub",
        "width": 1360,
        "height": 960,
        "minWidth": 850,
        "minHeight": 650,
        "backgroundColor": "#0b1019"
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "useLocalToolsDir": true,
    "resources": {
      "resources/runtime/taskhub-runtime.exe": "runtime/taskhub-runtime.exe",
      "resources/runtime/settings.json": "runtime/settings.json",
      "resources/runtime/report_styles.json": "runtime/report_styles.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0ODgzRTdDMEI1M0MwNTYKUldSV3dGTUxmRDZJSkl5eGhvRE92bVZMS05WajZtdFpxeGpTUkN6QndvMS91bWM0Vk9EU0ZyZEoK",
      "endpoints": [
        "https://github.com/devDaniel0330/task-hub/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
